# ── Required ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for the admin UI. With nginx on 8090, same-origin requests
# from the browser don't require CORS, but list the nginx port for safety.
# Single-server default: http://<your-ip>:8090  |  With TLS: https://yourdomain.com
CORS_ORIGINS=http://localhost:8090
